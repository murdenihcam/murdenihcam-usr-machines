; RAM-PS "RAM PITCH": a two-voice pitch shifter on the main output (mono, as
; RAM-R records it). Its own output is part of the main output, so shifted
; sound comes back in and is shifted again: a rising (or falling) spiral whose
; depth follows the track's level, on top of FB. The main output goes into a
; ring in a RAM slot's memory, lent by RAM_WORKSPACE (slot hunting and
; clearing: ram_ring.inc, shared with RAM-ST); MODE HOLD stops recording, so
; the shifter keeps playing the last window (a pitched freeze).
;
; Each voice is a classic delay-line shifter: two read heads half a window apart,
; each moving at the voice's rate, each faded by a triangle over the window's
; phase (the two always sum to 1). A head jumps back across the window at its
; phase wrap, where its fade is at zero; the jump and the fades are handled per
; block, the reads per sample (nearest frame).
;
; Parameters, Y:(r6+1..8):
;   1 PTCH  raw14 bipolar  voice 1: (setting - 64) * 3/8 semitones: -24..+24
;   2 PTC2  raw14 bipolar  voice 2 likewise; 64 = off
;   3 ENTI  raw14 bipolar  pitch swoop fired by TRIG: +-12 semitones, settling in about 0.5 s; 64 = off
;   4 FB    unipolar Q23   the shifted sound back into the ring, gain up to 0.71 (above
;                          that the spiral through the main output runs away)
;   5 DLAY  unipolar Q23   predelay, up to 200 ms
;   6 MODE  boolean        0 REC, 1 HOLD (recording stops; the last window plays on)
;   7 WIN   raw14          window 512 * 32^(WIN / 127) frames: 12 ms (smooth) .. 370 ms (smeared)
;   8 SCAT  unipolar Q23   each head, when it jumps back, lands up to SCAT * W further back at
;                          random: a grainy, scattered shift; 0 = none
;
; Y state: 9 slot  10 ring base  11 ring mask  12 words cleared  13 CAP
; 14 write offset (the virtual write head)  15 FILL  16 voice 1 phase  17 voice 2
; phase  18 random seed  19 swoop envelope  20.. scratch  37..40 the four heads'
; scatter offsets (frames).

P_PTCH  equ 1
P_PTC2  equ 2
P_ENTI  equ 3
P_FB    equ 4
P_DLAY  equ 5
P_MODE  equ 6
P_WIN   equ 7
P_SCAT  equ 8
S_SLOT  equ 9
S_RB    equ 10
S_RM    equ 11
S_CLR   equ 12
S_CAP   equ 13
S_W     equ 14
S_FILL  equ 15
S_PH1   equ 16
S_PH2   equ 17
S_SEED  equ 18
S_EE    equ 19
T_W     equ 20
T_WR    equ 21
T_VD    equ 22
T_DV    equ 23
T_AMP   equ 24
T_SW    equ 25
T_F     equ 26
T_OCT   equ 27
T_RI    equ 28
T_RF    equ 29
T_DPH   equ 30
T_PH    equ 31
T_HP    equ 32
T_HO    equ 36
T_MP    equ 33
T_OA    equ 34
T_OB    equ 35
S_O1A   equ 37
S_O1B   equ 38
S_O2A   equ 39
S_O2B   equ 40

D_MIN   equ 192                 ; nearest read distance: ahead of a 4x head over a block
EE_DEC  equ $7f5c29             ; swoop envelope per block (0.995: about 0.15 s)
RING_MAX equ $40000             ; ring sizes for ram_ring.inc
RING_MIN equ $4000
CHUNK   equ 256
MARGIN  equ 2048

        section RAM_PSHIFT
RENDER:
        movec   #>$ffffff,m6
        include 'ram_ring.inc'
RING_READY:
MAIN_POS:
        move    x:>$000000,a    ; kind 1 / main-output position: this block's 32 pairs
MAIN_RING:
        move    #>$000000,x0    ; kind 1 / the 256-word main-output ring
        sub     x0,a            ; the block's offset in the ring (as MAIN REC)
        and     #>$ff,a
        add     x0,a
        move    a1,y:(r6+T_MP)
        bsr     TBASE
        ; ---- window, read distance, write-head speed (REC 1, HOLD 0) ----
        move    y:(r6+P_WIN),a
        asr     #7,a,a
        move    #>127,x0
        cmp     x0,a
        tfr     x0,a    ifgt
        move    a1,n4
        move    #>TB_WIN,n0
        lua     (r4)+n4,r0
        nop
        lua     (r0)+n0,r1
        movem   p:(r1),x0
        move    x0,y:(r6+T_W)
        move    #>TB_WINR,n0
        nop
        lua     (r0)+n0,r1
        movem   p:(r1),x0
        move    x0,y:(r6+T_WR)
        move    y:(r6+P_DLAY),x0 ; V - D_MIN - DLAY * 8820
        move    #>8820,y0
        mpy     x0,y0,a
        move    #>D_MIN,x0
        add     x0,a
        move    a1,x0
        move    y:(r6+S_W),a
        sub     x0,a
        move    a1,y:(r6+T_VD)
        move    #>$100000,a     ; 1.0 in Q4.20 ...
        move    y:(r6+P_MODE),b
        tst     b
        beq     R_DV
        clr     a               ; ... or 0 in HOLD
R_DV:
        move    a1,y:(r6+T_DV)
        ; ---- the swoop: offset (ENTI - 64) * 3/16 semitones (in 1/128) times its envelope ----
        move    y:(r6+S_EE),x0
        move    #>EE_DEC,y0
        mpy     x0,y0,a
        move    a1,y:(r6+S_EE)
        move    y:(r6+P_ENTI),a
        move    #>8192,x0
        sub     x0,a
        move    a1,x0
        move    #>$180000,y0    ; 0.1875
        mpy     x0,y0,a
        move    a1,x0
        move    y:(r6+S_EE),y0
        mpy     x0,y0,a
        move    a1,y:(r6+T_SW)
        ; ---- voices: each at amplitude 1, or 0.71 each when both play ----
POSITIONS:
        move    #>$000000,r0    ; kind 3 / TEMP_X: the voices add into it
        clr     a
        rep     #32
        move    a,x:(r0)+
        move    #>$7fffff,a
        move    y:(r6+P_PTC2),b
        move    #>8192,x0
        cmp     x0,b
        beq     R_AMP
        move    #>$5a827a,a     ; two voices: 0.71 each
R_AMP:
        move    a1,y:(r6+T_AMP)
        move    y:(r6+S_O1A),x0
        move    x0,y:(r6+T_OA)
        move    y:(r6+S_O1B),x0
        move    x0,y:(r6+T_OB)
        move    y:(r6+P_PTCH),a
        move    y:(r6+S_PH1),b
        bsr     VOICE
        move    b1,y:(r6+S_PH1)
        move    y:(r6+T_OA),x0
        move    x0,y:(r6+S_O1A)
        move    y:(r6+T_OB),x0
        move    x0,y:(r6+S_O1B)
        move    y:(r6+P_PTC2),a
        move    #>8192,x0
        cmp     x0,a
        beq     R_OUT
        move    y:(r6+S_O2A),x0
        move    x0,y:(r6+T_OA)
        move    y:(r6+S_O2B),x0
        move    x0,y:(r6+T_OB)
        move    y:(r6+P_PTC2),a
        move    y:(r6+S_PH2),b
        bsr     VOICE
        move    b1,y:(r6+S_PH2)
        move    y:(r6+T_OA),x0
        move    x0,y:(r6+S_O2A)
        move    y:(r6+T_OB),x0
        move    x0,y:(r6+S_O2B)
R_OUT:
        ; ---- to the output; temporary X keeps it for the feedback ----
ACC_X2:
        move    #>$000000,r3    ; kind 3 / TEMP_X
        dor     #32,R_OUT_END
        move    x:(r3)+,a
        move    a,y:(r7)+
R_OUT_END:
        ; ---- REC: the main output plus FB times the shifted sound into the ring ----
        move    y:(r6+P_MODE),a
        tst     a
        bne     R_DONE
        move    y:(r6+T_MP),r5
        move    y:(r6+S_RB),a   ; the write offset steps by 32 in a ring of 2^n >= 2^14:
        move    y:(r6+S_W),x0   ; a block never wraps
        add     x0,a
        move    a1,r1
        move    y:(r6+P_FB),x0  ; FB 127 = gain 0.71 (90 / 127 of the full scale)
        move    #>$5ab688,y0
        mpy     x0,y0,a
        move    a1,y0
ACC_X3:
        move    #>$000000,r3    ; kind 3 / TEMP_X
        dor     #32,R_WR_END
        move    x:(r5)+,a       ; (left + right) / 2
        move    x:(r5)+,x0
        add     x0,a
        asr     a
        move    x:(r3)+,x1
        mac     x1,y0,a
        move    a,y:(r1)+
R_WR_END:
        move    y:(r6+S_W),a
        move    #>32,x0
        add     x0,a
        move    y:(r6+S_RM),x1
        and     x1,a
        move    a1,y:(r6+S_W)
        move    y:(r6+S_CAP),x1
        move    y:(r6+S_FILL),a
        add     x0,a
        cmp     x1,a
        tfr     x1,a    ifgt
        move    a1,y:(r6+S_FILL)
R_DONE:
        rts

; One voice: A1 = its pitch setting (raw14), B1 = its phase (Q23, 0..1).
; Adds its two heads into temporary X; returns the next phase in B1.
VOICE:
        move    b1,y:(r6+T_PH)
        move    #>8192,x0       ; (setting - 64) * 3/8 semitones, in 1/128, plus the swoop
        sub     x0,a
        move    a1,x0
        move    #>$300000,y0
        mpy     x0,y0,a
        move    y:(r6+T_SW),x0
        add     x0,a
        move    a1,y:(r6+T_F)
        bsr     RATE            ; X = rate, 24.24
        move    x1,y:(r6+T_RI)
        move    x0,y:(r6+T_RF)
        ; phase step per block = (write-head speed - rate) * 32 / W, as Q23
        move    x1,a
        move    x0,a0
        asl     #20,a,a         ; rate as Q4.20
        move    a1,x0
        move    y:(r6+T_DV),a
        sub     x0,a
        move    a1,x0
        move    y:(r6+T_WR),y0
        mpy     x0,y0,a
        asl     #3,a,a
        move    a1,y:(r6+T_DPH)
        ; head A at the phase, head B half a window on
        move    y:(r6+T_PH),a
        move    y:(r6+T_OA),x0
        move    x0,y:(r6+T_HO)
        bsr     HEAD
        move    y:(r6+T_PH),a
        move    #>$400000,x0
        add     x0,a
        bsr     WRAP1
        move    y:(r6+T_OB),x0
        move    x0,y:(r6+T_HO)
        bsr     HEAD
        ; a head whose phase wraps in this step jumps back: a new scatter offset
        move    y:(r6+T_PH),a
        move    #>$400000,x0
        add     x0,a
        bsr     WRAP1
        move    y:(r6+T_DPH),x0
        add     x0,a
        tfr     a,b
        bsr     WRAP1           ; (keeps B)
        cmp     a,b
        beq     V_B_SAME
        bsr     SCATTER
        move    a1,y:(r6+T_OB)
V_B_SAME:
        move    y:(r6+T_PH),a   ; the next phase (head A's)
        move    y:(r6+T_DPH),x0
        add     x0,a
        tfr     a,b
        bsr     WRAP1
        move    a1,y:(r6+T_PH)
        cmp     a,b
        beq     V_A_SAME
        bsr     SCATTER
        move    a1,y:(r6+T_OA)
V_A_SAME:
        move    y:(r6+T_PH),b
        rts

; A1 = a random offset of 0 .. SCAT * W frames.
SCATTER:
        move    y:(r6+S_SEED),x0
        move    #>$19660d,y0
        mpy     x0,y0,a
        asr     a
        move    a0,a
        move    #>$6ef35f,x0
        add     x0,a
        move    a1,y:(r6+S_SEED)
        abs     a
        move    a1,x0
        move    y:(r6+P_SCAT),y0
        mpy     x0,y0,a
        move    a1,x0
        move    y:(r6+T_W),y0
        mpy     x0,y0,a
        rts

; A = A wrapped into 0..1 (Q23; A within -1..2).
WRAP1:
        move    #>$800000,x0    ; -1.0
        tst     a
        bge     WRAP_HI
        sub     x0,a            ; + 1
        rts
WRAP_HI:
        move    #>$7fffff,x1
        cmp     x1,a
        ble     WRAP_END
        add     x0,a            ; - 1
WRAP_END:
        rts

; One head at phase A1 (Q23): 32 nearest reads from V - D - phase * W onwards at
; the voice's rate, faded from tri(phase) to tri(phase + step), into temporary X.
HEAD:
        move    a1,y:(r6+T_HP)
        move    a1,x0
        move    y:(r6+T_W),y0
        mpy     x0,y0,a         ; phase * W, 24.24
        move    y:(r6+T_HO),x0  ; plus the head's scatter offset
        add     x0,a
        neg     a
        move    y:(r6+T_VD),b
        add     b,a             ; the first position
        move    y:(r6+T_RI),x1
        move    y:(r6+T_RF),x0
        move    y:(r6+S_RM),y1
        move    y:(r6+S_RB),y0
POSITIONS2:
        move    #>$000000,r0    ; kind 4 / TEMP_Y
        dor     #32,HD_POS_END
        tfr     a,b
        and     y1,b
        or      y0,b
        add     x,a     b1,y:(r0)+
HD_POS_END:
        ; fades: tri(p) = 1 - |2p - 1|, the end one at least 0, times the voice's amplitude
        move    y:(r6+T_HP),a
        bsr     TRI
        move    a1,y:(r6+T_F)
        move    y:(r6+T_HP),a
        move    y:(r6+T_DPH),x0
        add     x0,a
        bsr     TRI
        move    y:(r6+T_F),b
        sub     b,a
        asr     #5,a,a
        move    a1,x1           ; X1 = step, B = start
POSITIONS3:
        move    #>$000000,r0    ; kind 4 / TEMP_Y
ACC_X:
        move    #>$000000,r5    ; kind 3 / TEMP_X
        dor     #32,HD_RD_END
        move    y:(r0)+,r2
        move    b1,y1
        move    x:(r5),a
        move    y:(r2),x0
        mac     x0,y1,a
        add     x1,b
        move    a,x:(r5)+
HD_RD_END:
        rts

; A1 = max(0, 1 - |2 A - 1|) * amplitude (A: phase, Q23, possibly a step past 0..1).
TRI:
        move    #>$400000,x0
        sub     x0,a
        abs     a
        asl     a
        move    #>$7fffff,b
        sub     a,b
        bge     TRI_POS
        clr     b
TRI_POS:
        move    b1,x0
        move    y:(r6+T_AMP),y0
        mpy     x0,y0,a
        rts

; X = 2^(T_F / 1536) in 24.24 frames per sample (T_F in 1/128 semitones, clamped
; to +-32 semitones): semitone table and octave shift.
RATE:
        move    y:(r6+T_F),a
        move    #>4095,x0
        cmp     x0,a
        tfr     x0,a    ifgt
        move    #>$fff000,x0    ; -4096
        cmp     x0,a
        tfr     x0,a    iflt
        tfr     a,b
        asr     #7,b,b          ; whole semitones s, -32..31
        and     #>$7f,a         ; 1/128-semitone steps ...
        lsl     #16,a           ; ... as a Q23 fraction
        move    a1,y:(r6+T_F)
        move    #>72,x0
        add     x0,b            ; t = s + 72, 8..135
        move    b1,x1
        move    #>$0aaaab,y0    ; 1/12, rounded up
        mpy     x1,y0,a         ; A1 = t / 12, the octave + 6
        move    a1,y:(r6+T_OCT)
        move    a1,a
        asl     #2,a,a
        move    a1,y1
        asl     #1,a,a
        add     y1,a            ; 12 * octave
        move    x1,b
        sub     a,b             ; semitone within the octave, 0..11
        move    b1,n4
        lua     (r4)+n4,r0
        movem   p:(r0)+,x0      ; 2^(n/12)/4
        movem   p:(r0),x1       ; one semitone higher
        move    x1,b
        sub     x0,b
        move    b1,y1
        move    y:(r6+T_F),y0
        mpy     y0,y1,b
        add     x0,b
        move    #>$010000,x0    ; native step 1.0 (Q16.16)
        move    b1,y0
        mpy     x0,y0,a         ; A1:A0 = 2^(n/12) / 4 * 2^40
        move    y:(r6+T_OCT),x0
        move    #>20,b
        sub     x0,b
        move    b1,x0
        asr     x0,a,a          ; 24.24 frames/sample
        move    a1,x1
        move    a0,x0
        rts

SILENCE:
        clr     a
        rep     #32
        move    a,y:(r7)+       ; every path writes the whole output block
        rts

; R4 = the constant tables (linear addressing).
TBASE:
TABLE_BASE:
        move    #>TABLES,r4
        movec   #>$ffffff,m4
        rts

; ---- cold code ----
INIT:
        movec   #>$ffffff,m6
        clr     a
        move    a,y:(r6+S_RB)
        move    a,y:(r6+S_RM)
        move    a,y:(r6+S_EE)
        bsr     RING_RESET
        move    r1,a            ; a different random sequence on every track
        move    #>$2a5b3d,x0
        add     x0,a
        move    a1,y:(r6+S_SEED)
        move    r1,a            ; RAM slot: track number mod 4
        and     #>3,a
        move    a1,y:(r6+S_SLOT)
        rts

TRIG:
        movec   #>$ffffff,m6
        move    #>$7fffff,a     ; the swoop starts again
        move    a,y:(r6+S_EE)
        rts

; ram_ring.inc callbacks: a new or lost ring starts from silence.
RING_RESET:
RING_LOST:
        clr     a
        move    a,y:(r6+S_W)
        move    a,y:(r6+S_FILL)
        move    a,y:(r6+S_PH1)
        move    a,y:(r6+S_PH2)
        move    a,y:(r6+S_O1A)
        move    a,y:(r6+S_O1B)
        move    a,y:(r6+S_O2A)
        move    a,y:(r6+S_O2B)
        rts

        include 'tables.inc'
        endsec
